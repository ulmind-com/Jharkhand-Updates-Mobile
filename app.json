{
  "expo": {
    "name": "Jharkhand Updates",
    "slug": "InYourArea-Mobile",
    "version": "1.1.0",
    "scheme": "jharkhand",
    "orientation": "portrait",
    "icon": "./assets/julogo_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#004d2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jharkhand.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "InYourArea requires your location to show relevant local news, community events, properties, and weather in your surrounding area.",
        "NSPhotoLibraryUsageDescription": "InYourArea requires access to your photo library to attach media to your community posts, job listings, properties, and events.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/julogo_adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.jharkhand.app",
      "versionCode": 2,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification_icon.png",
          "color": "#006A4E",
          "androidMode": "default",
          "sounds": [
            "./assets/sounds/startup_chime.wav"
          ]
        }
      ],
      [
        "expo-background-fetch"
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.jharkhand.app.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jharkhand.app.onesignal"
                    ]
                  }
                },
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.jharkhand.app.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jharkhand.app.onesignal"
                    ]
                  }
                },
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.jharkhand.app.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jharkhand.app.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "78ab2a93-ba61-467c-b768-d0d6abbd9519"
      }
    },
    "owner": "newsomedia"
  }
}
